/* ==== Smoco Desktop 全局样式 ====
   通过 setObjectName 给控件分类，避免内嵌 setStyleSheet 重复。
   加载方式见 styles.py。
*/

/* 图标按钮：透明背景，圆形 hover（⚙ 📋 🔄 📜） */
QPushButton#iconButton {
    border: none;
    background-color: transparent;
    font-size: 18px;
}
QPushButton#iconButton:hover {
    background-color: #e0e0e0;
    border-radius: 16px;
}

/* 图标按钮下方的文字说明 */
QLabel#iconLabel {
    font-size: 10px;
    color: #888888;
}

/* 链接按钮：透明背景的文字按钮（← 返回） */
QPushButton#linkButton {
    background-color: transparent;
    border: none;
    padding: 6px 12px;
    font-size: 14px;
}
QPushButton#linkButton:hover {
    background-color: #e0e0e0;
    border-radius: 4px;
}

/* 分页按钮：浅灰边框 */
QPushButton#paginationButton {
    background-color: #f5f5f5;
    border: 1px solid #ccc;
    padding: 6px 16px;
    border-radius: 4px;
    font-size: 13px;
}
QPushButton#paginationButton:hover:!disabled {
    background-color: #e0e0e0;
}
QPushButton#paginationButton:disabled {
    background-color: #fafafa;
    color: #aaa;
}

/* 主操作按钮：绿色（开始转录、复制原文/译文） */
QPushButton#primaryButton {
    background-color: #4CAF50;
    color: white;
    border: none;
    padding: 12px 30px;
    border-radius: 4px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#primaryButton:hover {
    background-color: #45a049;
}
QPushButton#primaryButton:pressed {
    background-color: #3d8b40;
}
QPushButton#primaryButton:disabled {
    background-color: #cccccc;
}
/* primaryButton 紧凑变体（弹窗内的复制按钮） */
QPushButton#primaryButtonCompact {
    background-color: #4CAF50;
    color: white;
    border: none;
    padding: 8px 18px;
    border-radius: 4px;
}
QPushButton#primaryButtonCompact:hover {
    background-color: #45a049;
}

/* 危险按钮：红色（停止录制） */
QPushButton#dangerButton {
    background-color: #f44336;
    color: white;
    border: none;
    padding: 6px 12px;
    border-radius: 4px;
}
QPushButton#dangerButton:hover {
    background-color: #d32f2f;
}

/* 次要按钮：浅灰边框（导出、打开目录、刷新、关闭） */
QPushButton#secondaryButton {
    background-color: #2196F3;
    color: white;
    border: none;
    padding: 6px 16px;
    border-radius: 4px;
    font-size: 13px;
}
QPushButton#secondaryButton:hover {
    background-color: #1976D2;
}
/* secondaryButton 灰色变体（关闭按钮等） */
QPushButton#secondaryButtonGray {
    background-color: #757575;
    color: white;
    border: none;
    padding: 8px 18px;
    border-radius: 4px;
}
QPushButton#secondaryButtonGray:hover {
    background-color: #616161;
}

/* 内容列表（设备列表、session 列表） */
QListWidget#contentList {
    border: 1px solid #ccc;
    border-radius: 4px;
    padding: 4px;
    font-size: 13px;
}
QListWidget#contentList::item {
    padding: 12px;
    border-bottom: 1px solid #eee;
}
QListWidget#contentList::item:selected {
    background-color: #e3f2fd;
    color: #000;
}

/* 内容表格（转录表格、entries 表格） */
QTableWidget#contentTable {
    border: 1px solid #ccc;
    border-radius: 4px;
    gridline-color: #eee;
    font-size: 13px;
}
QTableWidget#contentTable::item {
    padding: 8px;
}
QTableWidget#contentTable::item:selected {
    background-color: #e3f2fd;
    color: #000;
}
QTableWidget#contentTable QHeaderView::section {
    background-color: #f5f5f5;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #ccc;
    font-weight: bold;
}

/* 只读文本框（详情弹窗原文/译文） */
QTextEdit#readOnlyText {
    border: 1px solid #ccc;
    border-radius: 4px;
    padding: 8px;
    font-size: 14px;
}
